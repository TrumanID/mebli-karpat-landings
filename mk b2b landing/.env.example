# Stage: "preview" shows TODO(client) markers; "production" hides unknown blocks (SPEC §3.3, §6.11).
PUBLIC_STAGE=preview
# Cookieless, EU-hosted analytics (D8). Leave empty to send nothing. Plausible-compatible event endpoint.
PUBLIC_ANALYTICS_ENDPOINT=
PUBLIC_ANALYTICS_DOMAIN=b2b.meblikarpat.com.ua

# Cloudflare Pages Function /api/rfq (server-side secrets, never PUBLIC_).
RFQ_TO_EMAIL=
RFQ_FROM_EMAIL=
BREVO_API_KEY=
RFQ_WEBHOOK_URL=
# Signs the self-hosted form captcha. Any long random string, e.g. `openssl rand -hex 32`. The form refuses requests without it.
RFQ_CAPTCHA_SECRET=
