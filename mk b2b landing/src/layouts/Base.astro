---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import displayFontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, liveLocales, type Locale } from '../i18n/locales.ts';
import { localizedPath } from '../i18n/routes.ts';
import { alternates, absolute, getContent, isIndexable, publishedLocales, type PageKey } from '../lib/content.ts';
import { serialize } from '../lib/jsonld.ts';

interface Props { locale: Locale; page: PageKey; title: string; description: string; graph: object[] }
const { locale, page, title, description, graph } = Astro.props;
const { ui } = getContent(locale);
const info = locales[locale];
const path = localizedPath(page, locale);
const noindex = !isIndexable(page) || !(liveLocales as readonly Locale[]).includes(locale);
const otherLocales = publishedLocales.filter((l) => l !== locale);
const ogImage = absolute('/img/og-default.jpg');
---
<!doctype html>
<html lang={info.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={absolute(path)} />
    {alternates(page, locale).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mebli Karpat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(path)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={info.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={locales[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <meta name="theme-color" content="#171616" />
    <link rel="preload" as="font" type="font/woff2" href={displayFontUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin />
    <slot name="head" />
    <script type="application/ld+json" set:html={serialize(graph)}></script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3 focus:m-2">{ui.skip}</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer locale={locale} page={page} />
    <slot name="after" />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
