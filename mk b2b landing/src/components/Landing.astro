---
import { Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import T from './T.astro';
import ProductCard from './ProductCard.astro';
import Filters from './Filters.astro';
import RfqForm from './RfqForm.astro';
import type { Locale } from '../i18n/locales.ts';
import { localizedPath } from '../i18n/routes.ts';
import { getContent } from '../lib/content.ts';
import { baseGraph, faqGraph, itemListGraph, servicesGraph } from '../lib/jsonld.ts';
import { photo } from '../lib/images.ts';
import { site } from '../lib/site.ts';
import { shown, isProduction, splitTodo } from '../lib/stage.ts';

const { locale } = Astro.props as { locale: Locale };
const { landing: c, faq, ui } = getContent(locale);
const home = localizedPath('home', locale);

const all = (await getCollection('products')).map((e) => e.data).filter((p) => p.i18n[locale]);
const tables = all.filter((p) => p.category === 'tables');
const chairs = all.filter((p) => p.category === 'chairs');
const order = ['tables', 'chairs'] as const;

const graph = [
  ...baseGraph({ locale, path: home, title: c.title, description: c.description, orgDescription: c.org.description, knowsAbout: c.org.knowsAbout, crumbs: [{ name: site.name, path: home }] }),
  itemListGraph(home, [...tables, ...chairs]),
  ...servicesGraph(c.org.services, home),
  faqGraph(locale, home, faq),
];

const heroSrc = photo('chicago-1.jpg');
const heroPreload = await getImage({ src: heroSrc, format: 'avif', widths: [480, 800, 1000] });
const heroSizes = '(min-width: 900px) 36vw, 100vw';
const visibleTerms = c.terms.rows.filter((r) => shown(r.value)).map((r) => ({ ...r, value: isProduction ? splitTodo(r.value).text : r.value }));
const visibleFaq = faq.filter((f) => shown(f.a));
const steps = c.process.steps;
// Keeps a suspended compound such as "-Tische" on one line; there are no break opportunities after its hyphen.
const accent = c.hero.h1Accent;
const [heroMain, heroAccentTail] = accent && c.hero.h1.endsWith(accent) ? [c.hero.h1.slice(0, -accent.length), accent] : [c.hero.h1, ''];
const heroParts = heroMain.split(/(?<=\s)(-\S+)/);
// Decorative: every third product photo for the sliding band.
const stripPhotos = [...tables, ...chairs].filter((_, i) => i % 3 === 0).map((p) => p.images[0].src);
---
<Base locale={locale} page="home" title={c.title} description={c.description} graph={graph}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroPreload.srcSet.attribute} imagesizes={heroSizes} fetchpriority="high" />

  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero-rise hero-rise-2">{heroParts.map((part, i) => i % 2 ? <span class="whitespace-nowrap">{part}</span> : part)}{heroAccentTail && <em>{heroAccentTail}</em>}</h1>
      <div class="hero-row">
        <div class="hero-rise hero-rise-3">
          <p class="lead">{c.hero.sub}</p>
          <p class="hero-cta">
            <a href="#rfq" class="btn btn-on-green btn-arrow">{ui.cta.quote}</a>
            {site.catalogPdf
              ? <a href={site.catalogPdf} class="btn btn-ghost" data-event="catalog_download">{ui.cta.catalog}</a>
              : <a href="#range" class="btn btn-ghost">{ui.cta.range}</a>}
          </p>
        </div>
        <div class="hero-mosaic">
          <Picture src={heroSrc} formats={['avif', 'webp']} widths={[480, 800, 1000]} sizes={heroSizes} alt={c.hero.imageAlt} loading="eager" fetchpriority="high" decoding="sync" />
          <Picture src={photo(tables[0].images[0].src)} formats={['avif', 'webp']} widths={[320, 480]} sizes="18vw" alt="" loading="lazy" decoding="async" />
          <Picture src={photo('interior-enamel.jpg')} formats={['avif', 'webp']} widths={[320, 480]} sizes="18vw" alt="" loading="lazy" decoding="async" />
        </div>
      </div>
      <ul class="facts" aria-label={c.trust.map((t) => t.big).join(', ')}>
        {c.trust.map((t) => <li class="fact"><p class="fact-big">{t.big}</p><p class="fact-small">{t.small}</p></li>)}
      </ul>
    </div>
  </section>

  <div class="strip" aria-hidden="true">
    <ul>{stripPhotos.map((src) => <li><Picture src={photo(src)} formats={['avif', 'webp']} widths={[320, 480]} sizes="272px" alt="" loading="lazy" decoding="async" /></li>)}</ul>
  </div>

  <section id="segments" class="band" aria-labelledby="segments-h">
    <div class="wrap">
      <div class="section-head reveal"><h2 id="segments-h">{c.segments.h2}</h2></div>
      <ul class="bento">
        {c.segments.items.map((s) => (
          <li class="tile">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a href={`${home}?segment=${s.id}#rfq`} data-prefill>{s.cta}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="range" class="band band-grey" aria-labelledby="range-h">
    <div class="wrap">
      <div class="section-head reveal !mb-6"><h2 id="range-h">{c.range.h2}</h2><p>{c.range.intro}</p></div>
      <nav class="range-jump" aria-label={c.range.h2} data-range-jump>
        {order.map((cat) => <a href={`#range-${cat}`}>{c.range[cat]} <span class="font-normal">{(cat === 'tables' ? tables : chairs).length}</span></a>)}
      </nav>
      {order.map((cat, i) => {
        const items = cat === 'tables' ? tables : chairs;
        return (
          <div id={`range-${cat}`} class:list={['range-block', i > 0 && 'mt-16']} data-range-block>
            <h3 class="range-title reveal">{c.range[cat]}</h3>
            <Filters locale={locale} id={cat} types={cat === 'tables' ? ['dining', 'bistro', 'round', 'extendable'] : ['chair', 'bar', 'upholstered', 'armrests']} />
            <ul class="card-grid" data-grid>{items.map((p) => <ProductCard product={p} locale={locale} />)}</ul>
            <p data-none hidden class="py-8 text-grey-600">{ui.filter.none}</p>
            <p data-show-all-wrap hidden class="mt-8 text-center"><button type="button" class="btn btn-secondary" data-show-all>{ui.filter.showAll.replace('{count}', String(items.length))}</button></p>
          </div>
        );
      })}
    </div>
  </section>

  <section id="services" class="panel on-dark band" aria-labelledby="services-h">
    <div class="wrap">
      <div class="section-head reveal"><h2 id="services-h">{c.services.h2}</h2></div>
      <ul class="service-list">
        {c.services.items.map((s) => (
          <li class="service">
            <h3>{s.title}</h3>
            <p class="mt-2">{s.short}</p>
            {shown(s.more) && (
              <details class="disclosure mt-2">
                <summary class="text-[0.9375rem]">{ui.more}<span class="sr-only">: {s.title}</span></summary>
                <p class="pb-2 text-[0.9375rem]"><T value={s.more} /></p>
              </details>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="material" class="band" aria-labelledby="material-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_minmax(0,24rem)] xl:gap-16">
      <div class="min-w-0">
        <div class="section-head reveal !mb-8"><h2 id="material-h">{c.material.h2}</h2><p>{c.material.intro}</p></div>
        <div class="table-card reveal" tabindex="0" role="group" aria-label={c.material.tableCaption}>
          <table class="w-full text-[0.9375rem]">
            <caption class="sr-only">{c.material.tableCaption}</caption>
            <thead><tr>{c.material.columns.map((col) => <th scope="col" class="font-bold">{col}</th>)}</tr></thead>
            <tbody>{c.material.rows.map((r) => <tr><th scope="row" class="font-bold text-charcoal">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
          </table>
        </div>
        {shown(c.material.swatchTodo) && <p class="mt-3"><T value={c.material.swatchTodo} /></p>}
        <h3 class="text-xl mt-10">{c.material.finishesH3}</h3>
        <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-4 mt-4">
          {c.material.finishes.map((f) => <div class="border-t border-grey-300 pt-3"><dt class="font-semibold text-charcoal">{f.name}</dt><dd class="text-[0.9375rem] text-grey-600 mt-1">{f.text}</dd></div>)}
        </dl>
        <h3 class="text-xl mt-10">{c.material.careH3}</h3>
        <p class="mt-3 text-[0.9375rem]"><T value={c.material.care} /></p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-1 gap-4 content-start">
        <Picture src={photo('interior-chicago.jpg')} formats={['avif', 'webp']} widths={[320, 640]} sizes="(min-width: 1024px) 24rem, 50vw" alt={c.material.imageAlt} loading="lazy" decoding="async" class="rounded-photo reveal" />
        <Picture src={photo('interior-enamel.jpg')} formats={['avif', 'webp']} widths={[320, 640]} sizes="(min-width: 1024px) 24rem, 50vw" alt={c.material.image2Alt} loading="lazy" decoding="async" class="rounded-photo reveal" />
      </div>
    </div>
  </section>

  <section id="quality" class="band band-grey" aria-labelledby="quality-h">
    <div class="wrap">
      <div class="section-head reveal"><h2 id="quality-h">{c.quality.h2}</h2><p>{c.quality.intro}</p></div>
      <div class="grid gap-4 lg:grid-cols-3">
        <div class="q-card">
          <h3 class="text-xl">{c.quality.factsH3}</h3>
          <ul class="mt-4 grid gap-3 text-[0.9375rem]">
            {c.quality.facts.filter(shown).map((f) => <li class="border-t border-hairline pt-3"><T value={f} /></li>)}
          </ul>
        </div>
        <div class="q-card">
          <h3 class="text-xl">{c.quality.eudrH3}</h3>
          <p class="mt-4 text-[0.9375rem]">{c.quality.eudrIntro}</p>
          <ul class="mt-3 grid gap-2 text-[0.9375rem] list-disc ps-5">{c.quality.eudr.map((e) => <li>{e}</li>)}</ul>
          {shown(c.quality.eudrTodo) && <p class="mt-3"><T value={c.quality.eudrTodo} /></p>}
        </div>
        {shown(c.quality.docsTodo) && (
          <div class="q-card">
            <h3 class="text-xl">{c.quality.docsH3}</h3>
            <p class="mt-4"><T value={c.quality.docsTodo} /></p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section id="process" class="band" aria-labelledby="process-h">
    <div class="wrap">
      <div class="section-head reveal"><h2 id="process-h">{c.process.h2}</h2></div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <p class="step-no" aria-hidden="true">{i + 1}</p>
            <h3 class="text-lg">{s.title}</h3>
            <p class="mt-2 text-[0.9375rem] text-grey-600"><T value={s.text} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {shown(c.projects.todo) && (
    <section id="projects" class="band" aria-labelledby="projects-h">
      <div class="wrap">
        <h2 id="projects-h">{c.projects.h2}</h2>
        <p class="mt-4"><T value={c.projects.todo} /></p>
      </div>
    </section>
  )}

  {visibleTerms.length > 0 && (
    <section id="terms" class="band band-grey" aria-labelledby="terms-h">
      <div class="wrap">
        <div class="section-head reveal"><h2 id="terms-h">{c.terms.h2}</h2></div>
        <dl class="max-w-3xl border-t border-grey-300">
          {visibleTerms.map((r) => <div class="grid sm:grid-cols-[14rem_1fr] gap-x-6 py-3 border-b border-grey-300"><dt class="font-semibold text-charcoal">{r.label}</dt><dd><T value={r.value} /></dd></div>)}
        </dl>
      </div>
    </section>
  )}

  <section id="faq" class="band grid" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
      <div class="section-head reveal !mb-0"><h2 id="faq-h">FAQ</h2></div>
      <div class="border-t border-hairline">
        {visibleFaq.map((f) => (
          <details class="disclosure faq-q border-b border-hairline">
            <summary>{f.q}</summary>
            <p class="pb-4 max-w-[46rem]"><T value={f.a} /></p>
          </details>
        ))}
      </div>
      </div>
    </div>
  </section>

  <section id="rfq" class="panel on-dark band text-white mb-2 lg:mb-4" aria-labelledby="rfq-h">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_20rem] xl:gap-20">
      <div class="min-w-0">
        <div class="section-head !mb-8"><h2 id="rfq-h">{c.rfq.h2}</h2><p class="!text-grey-300">{c.rfq.intro}</p>
          <p class="lg:hidden !text-grey-300 [&_a]:text-white [&_a]:underline">{ui.contact.heading}: <a href={`tel:${site.phone}`} data-event="phone_click" class="whitespace-nowrap">{site.phoneDisplay}</a> · <a href={`mailto:${site.email}`} data-event="email_click">{site.email}</a></p>
        </div>
        <div class="form-panel"><RfqForm locale={locale} tables={tables} chairs={chairs} /></div>
      </div>
      <aside aria-labelledby="contact-h" class="contact-aside [&_a]:text-white [&_a]:underline">
        <h3 id="contact-h" class="text-xl !text-white">{ui.contact.heading}</h3>
        <dl class="mt-4 grid gap-4 text-[0.9375rem]">
          {shown(c.rfq.person) && <div><dt class="font-semibold">{ui.contact.person}</dt><dd><T value={c.rfq.person} /></dd></div>}
          <div><dt class="font-semibold">{ui.contact.phone}</dt><dd><a href={`tel:${site.phone}`} data-event="phone_click" class="inline-flex items-center min-h-11">{site.phoneDisplay}</a></dd></div>
          <div><dt class="font-semibold">{ui.contact.email}</dt><dd><a href={`mailto:${site.email}`} data-event="email_click" class="inline-flex items-center min-h-11">{site.email}</a></dd></div>
          {site.whatsapp
            ? <div><dt class="font-semibold">{ui.contact.whatsapp}</dt><dd><a href={`https://wa.me/${site.whatsapp}`} data-event="whatsapp_click" rel="noopener" class="inline-flex items-center min-h-11">{ui.contact.whatsapp}</a></dd></div>
            : shown(c.rfq.whatsapp) && <div><dt class="font-semibold">{ui.contact.whatsapp}</dt><dd><T value={c.rfq.whatsapp} /></dd></div>}
          <div><dt class="font-semibold">{ui.contact.address}</dt><dd>{c.rfq.address}</dd></div>
          {shown(c.rfq.hours) && <div><dt class="font-semibold">{ui.contact.hours}</dt><dd><T value={c.rfq.hours} /></dd></div>}
          {shown(c.rfq.languages) && <div><dt class="font-semibold">{ui.contact.languages}</dt><dd><T value={c.rfq.languages} /></dd></div>}
        </dl>
      </aside>
    </div>
  </section>

  <a slot="after" href="#rfq" class="dock" data-selection-dock hidden><span class="badge" data-selection-badge hidden></span><span data-dock-label></span><span aria-hidden="true">→</span></a>
  <p class="sr-only" role="status" data-selection-live slot="after"></p>
  <nav slot="after" class="mobile-bar" data-mobile-bar aria-label={ui.cta.quote}>
    <a href={`tel:${site.phone}`} data-event="phone_click">{ui.cta.call}</a>
    {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} data-event="whatsapp_click" rel="noopener">{ui.cta.whatsapp}</a>}
    <a href="#rfq">{ui.cta.quoteShort} <span class="badge" data-selection-badge hidden></span></a>
  </nav>
</Base>
