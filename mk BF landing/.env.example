# "preview" (default) shows yellow TODO markers and the "example prices" banner.
# "production" hides them, and the build FAILS while prices, dates or the Christmas deadline are unconfirmed (src/data/offer.ts).
PUBLIC_STAGE=preview

# Server-side secrets for /api/order and /api/captcha (Cloudflare Pages Functions). Never prefix with PUBLIC_.
ORDER_TO_EMAIL=
ORDER_FROM_EMAIL=
BREVO_API_KEY=
# Signs the self-hosted captcha. Any long random string, e.g. `openssl rand -hex 32`. The form refuses requests without it.
CAPTCHA_SECRET=
