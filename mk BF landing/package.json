{
  "name": "mebli-karpat-black-friday",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "node scripts/preview-server.ts",
