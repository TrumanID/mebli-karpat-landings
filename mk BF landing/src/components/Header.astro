---
import { company } from '../data/offer.ts';
---
<header class="site-header" data-header>
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/img/logo.png" alt="Меблі Карпат" width="137" height="79" />
      <span class="brand-tag">Black Friday</span>
    </a>
    <nav class="header-nav" aria-label="Розділи">
      <a href="#chairs">Стільці</a>
      <a href="#tables">Столи</a>
      <a href="#how">Як замовити</a>
      <a href="#faq">Питання</a>
    </nav>
    <a href={`tel:${company.phone}`} class="header-phone">{company.phoneDisplay}</a>
    <a href="#order" class="btn btn-primary btn-sm header-cta">
      Заявка <span class="count-badge" data-count-badge hidden>0</span>
    </a>
  </div>
</header>
